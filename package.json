{
  "name": "quiz-randomizer",
  "productName": "QuizRandomizer",
  "version": "1.1.0",
  "description": "Desktop scoreboard that draws a random number on a second display: teams, no-repeat history, appearance presets",
  "author": "Vladislav Zhuzha",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhuzhavladislav/quiz-randomizer.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "keywords": [
    "electron",
    "quiz",
    "randomizer",
    "raffle",
    "random-number",
    "scoreboard",
    "second-display"
  ]
}
