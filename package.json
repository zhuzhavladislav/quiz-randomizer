{
  "name": "quiz-randomizer",
  "productName": "QuizRandomizer",
  "version": "1.0.0",
  "description": "QuizRandomizer - табло-рандомайзер для квизов и игр: случайное число на втором экране, команды, пресеты оформления",
  "author": "Vladislav Zhuzha",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhuzhavladislav/quiz-randomizer.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "adm-zip": "^0.5.18",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.6"
  }
}
